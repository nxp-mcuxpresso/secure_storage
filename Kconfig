menuconfig MCUX_COMPONENT_middleware.SECURE_STORAGE
	bool "Secure storage subsystem"
	help
	  The secure storage subsystem provides an implementation of the PSA Secure Storage API
	  functions on board targets that don't already have one.
	  It allows making use of the PSA Secure Storage API and persistent keys in the PSA Crypto
	  API in a standard and portable way.
	  It is configurable and different implementations can be used to accommodate the varying
	  capabilities of different devices.
	  In addition to providing functional support for the PSA Secure Storage API, depending on
	  the device-specific security features that are available and used, the subsystem may
	  secure the data stored through it at rest.
	  This is however highly dependent on the device and configuration in use, and not a
	  guarantee of the subsystem.

if MCUX_COMPONENT_middleware.SECURE_STORAGE

config SECURE_STORAGE_64_BIT_UID
	bool "Make psa_storage_uid_t 64-bit"
	help
	  Zephyr, by default, uses a 30-bit psa_storage_uid_t, which allows using only 32 bits to
	  identify entries.
	  UID ranges are defined for the different users of the API which guarantees that all the
	  UIDs fit within 30 bits. See for example the zephyr/psa/key_ids.h header file.
	  Enable this for backward compatibility if you are updating an existing installation with
	  stored entries that was using Zephyr prior to 4.3 or if for some reason you need the full
	  64-bit UID range.

    choice MCUX_COMPONENT_middleware.SECURE_STORAGE_ITS_IMPLEMENTATION
	prompt "Internal Trusted Storage (ITS) API implementation"

        config MCUX_COMPONENT_middleware.SECURE_STORAGE_ITS_IMPLEMENTATION
	    bool "ITS implementation with Transform and store"
	    select MCUX_COMPONENT_middleware.SECURE_STORAGE_ITS_STORE_MODULE
	    select MCUX_COMPONENT_middleware.SECURE_STORAGE_ITS_TRANSFORM_MODULE

        config MCUX_COMPONENT_middleware.SECURE_STORAGE_ITS_IMPLEMENTATION_WITH_ONLY_STORE
	    bool "ITS implementation with store"
	    select MCUX_COMPONENT_middleware.SECURE_STORAGE_ITS_STORE_MODULE
	    help
	      A ITS API implementation with storage only. This is for implementations
	      where security subsystem takes care of condifentiality and integrity of
	      data to be stored. This implementation dumps the data to be stored into storage
	      medium without any transformation.

    endchoice # MCUX_COMPONENT_middleware.SECURE_STORAGE_ITS_IMPLEMENTATION

config SECURE_STORAGE_ITS_MAX_DATA_SIZE
	int "Maximum data size of an ITS entry in bytes"
	default 128
	help
	  The maximum size, in bytes, that the data of an ITS entry can be.
	  Increasing this value increases the stack usage when serving PSA ITS API calls.

menuconfig MCUX_COMPONENT_middleware.SECURE_STORAGE_ITS_TRANSFORM_MODULE
	bool "ITS transform module"
	help
	  The module that handles the transformation and validation of the
	  ITS data before it's written to and after it's read from NVM.
	  The transform module is from Zephyr.

if MCUX_COMPONENT_middleware.SECURE_STORAGE_ITS_TRANSFORM_MODULE
rsource "zephyr/subsys/secure_storage/Kconfig.its_transform"
endif

menuconfig MCUX_COMPONENT_middleware.SECURE_STORAGE_ITS_STORE_MODULE
	bool "ITS store module"
	help
	  The module that handles the storage/retrieval of the ITS data to/from NVM.

if MCUX_COMPONENT_middleware.SECURE_STORAGE_ITS_STORE_MODULE
rsource "src/its/store/Kconfig.its_store"
endif

endif # MCUX_COMPONENT_middleware.SECURE_STORAGE
